<!DOCTYPE html>
<html lang="PT-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="style.css"
    <title>Formurario alternativo</title>
</head>
<body>
    <section class="containerPai"></section>
    <div class="card">
        <div class="esquerda">
            <div class="formLogin">
                <h2>Fazer login</h2>
                <form>
                    <input type="email" placeholder="E-mail">
                    <input type="password" placeholder="Senha">
                    <button type="submit">Entrar</button>
                </form>
            </div>
            <div class="facaLogin">
                <h2>Já tem <br>uma conta!</h2>
                <p>Lorem Ipsum has been the industry's standard dummy tex ever since the 1500s</p>
                <button>Faça Login</button>
            </div>
        </div>
        <div class="direita">
            <div class="formCadastro">
                <h2>Cadrasto</h2>
                <form>
                    <input type="text" placeholder="Nome">
                    <input type="email" placeholder="E-mail">
                    <input type="text" password="Senha">
                    <input type="text" password="Comfirme sua senha">
                    <button type="submit">Cadrastar</button>
                </form>

            </div>
            <div class="facaCadastro">
                <h2>Não tem</br> uma conta</h2>
                <p>Lorem Ipsum has been the industry's standard dummy tex ever since the 1500s</p>
                <button>Cadastre-se</button>
            </div>

        </div>
    </div>
</body>
</html>

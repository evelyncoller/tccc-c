*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body{
    color: white;
}
.containerPai{
    width: 100%;
    height: 10vh;
    background-color: #14151A;
    display: flex;
    justify-content: center;
    align-items: center;
}

.card{
    width: 100%;
    height: 100vh;
    background-color: rgba(225 225 225 /.10);
    border-radius: 32px;
    padding: 32px  20px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
}

.esquerda, .direita{
    width: 50%;
    height: 80%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.formLogin, .facalogin, .formCadrasto, .facaCadrasto{
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

form{
    display: flex;
    flex-direction: column;
    gap: 16px;
}

input, button{
    padding: 12px 20px;
    border-radius: 12px;
    border: none;
    outline: none;
}
